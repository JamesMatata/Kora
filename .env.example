SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_DOMAIN=http://127.0.0.1:8000

# Dedicated key for encrypted school secrets (M-Pesa keys, Daraja webhook token).
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Or use any long passphrase. After setting, run: manage.py reencrypt_credentials
KORA_CREDENTIALS_KEY=

# Optional: restrict Daraja callbacks to Safaricom / proxy IPs (comma-separated CIDRs).
# Leave empty in sandbox / local tunnels.
# DARAJA_CALLBACK_IP_ALLOWLIST=

# Platform billing cron (after schools are approved):
#   .venv/bin/python manage.py enforce_platform_billing
# Review school applications (staff users): /tenants/ops/applications/
# Edit tier rates / grace days in Django admin → Platform billing settings.

# Production (DEBUG=False) enables HTTPS redirect, secure cookies, and HSTS.
# Behind a reverse proxy that terminates TLS, keep:
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000

# Safaricom Daraja (fallback when a school has no encrypted keys)
# Environment: sandbox (default) or production — schools can override in Settings.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=174379
# For local C2B/STK callbacks use a public tunnel, e.g. https://xxxx.ngrok.io
# SITE_DOMAIN must match that public HTTPS origin.
# Callback URLs include ?tenant_id=<uuid>&token=<per-school webhook secret>

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
# Webhook URL must include the school UUID, e.g.
#   https://your-domain/api/v1/communications/twilio/whatsapp/?tenant_id=<school-uuid>
# Signature validation uses TWILIO_AUTH_TOKEN (required). No default-school fallback.
TWILIO_DEFAULT_SCHOOL_CODE=greenfields-academy

# Google Gemini (WhatsApp agent)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fee reminders — schedule on the host (cron / Task Scheduler), e.g. daily 08:00 Nairobi:
#   0 8 * * * cd /path/to/Kora && .venv/bin/python manage.py run_fee_reminders
# Or click “Run reminders now” under Dashboard → Settings (bypasses quiet hours).
# Windows Task Scheduler example:
#   Program: C:\path\to\Kora\.venv\Scripts\python.exe
#   Arguments: manage.py run_fee_reminders
#   Start in: C:\path\to\Kora
# Optional quiet-hour overrides (Africa/Nairobi):
# WHATSAPP_LOCAL_TZ=Africa/Nairobi
# WHATSAPP_QUIET_HOUR_START=20
# WHATSAPP_QUIET_HOUR_END=8

# Database backups — schedule daily, keep off-box copies:
#   .venv/bin/python manage.py backup_database
# Optional override:
# BACKUP_DIR=/var/backups/kora
